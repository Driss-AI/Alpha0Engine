# ============================================
# Alpha0Engine — Environment Variables
# ============================================
# Copy to .env — NEVER commit .env to GitHub.

# DATABASE (Railway injects automatically)
DATABASE_URL=postgresql://postgres:password@localhost:5432/alpha_engine

# SEC EDGAR (use real email — EDGAR Fair Access Policy)
EDGAR_USER_AGENT=Alpha0Engine contact@yourdomain.com

# FINNHUB (free tier: https://finnhub.io/) — used by ingest-news
FINNHUB_API_KEY=

# FINANCIAL MODELING PREP (https://site.financialmodelingprep.com/) — the
# primary market-data source. This is the only feed that supplies VOLUME and
# FLOAT for the whole universe; without it lens 4 (float mechanics) and lens 5
# (smart money) have almost no data and nothing reaches high conviction.
# Leave empty to fall back to Yahoo/Stooq/Finnhub (price only, degraded).
FMP_API_KEY=
# shares-float costs one call per symbol; budget is spent smallest-cap first.
FMP_FLOAT_BUDGET=2000

# TELEGRAM private alerts (alert-engine) — create a bot via @BotFather, get your
# chat id from @userinfobot. Leave empty to disable (alerts still recorded in DB).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# WORKER RUN MODE (loop for dev/compose, once for Railway cron)
RUN_MODE=loop

# APP
ENVIRONMENT=development
LOG_LEVEL=INFO

# AUTH — TWO SEPARATE KEYS, REQUIRED IN PROD
# API_SECRET_KEY = admin / write key. NEVER embed in HTML or client-side code.
# VIEWER_API_KEY = read-only key, safe to expose in dashboard HTML.
# Generate two distinct random strings, e.g. `python3 -c "import secrets; print(secrets.token_urlsafe(32))"`
API_SECRET_KEY=change-this-to-a-long-random-string
VIEWER_API_KEY=change-this-to-a-different-long-random-string

# CORS (comma-separated origins, leave empty for dev wildcard)
ALLOWED_ORIGINS=

# RATE LIMITING ("60/minute", "100/hour")
RATE_LIMIT=60/minute

# ANALYST (optional) — Claude-powered takes on new alerts + watchlist checkups.
# Leave empty to disable; the engine's deterministic memos work without it.
ANTHROPIC_API_KEY=
ANALYST_MAX_CALLS_PER_RUN=8
